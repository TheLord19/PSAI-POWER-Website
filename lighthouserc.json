{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3210",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3210/",
        "http://localhost:3210/capabilities/protection-and-control",
        "http://localhost:3210/projects",
        "http://localhost:3210/firm",
        "http://localhost:3210/contact-us"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],

        "categories:performance": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 1500 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],

        "uses-responsive-images": "off",
        "unused-javascript": "off"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
